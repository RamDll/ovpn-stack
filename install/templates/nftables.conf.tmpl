#!/usr/sbin/nft -f
# Управляется install/bootstrap.sh (nftables-apply) — не редактировать руками.
# Регенерируется при каждом прогоне установщика и при доустановке режима.
#
# Docker пишет свои правила в отдельные цепочки НИЖЕ уровнем и обходит эту
# политику для всего, что опубликовано на 0.0.0.0 — поэтому всё, что не
# должно торчать наружу, публикуется в docker-compose только на 127.0.0.1.
# ufw сознательно не используется поверх Docker (см. install/README.md, §7).

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop

        icmp type { echo-request, destination-unreachable, time-exceeded } accept
        icmpv6 type { echo-request, destination-unreachable, time-exceeded, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept

        tcp dport @@SSH_PORT@@ accept  # SSH

@@VLESS_RULE@@
        tcp dport 80  accept   # ACME http-01
        tcp dport 8443 accept  # nginx — панели

@@OPENVPN_RULE@@
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop

        # Docker forward'ит трафик контейнеров через этот хук — без явного
        # accept здесь ни у одного контейнера нет исходящей сети (DNS,
        # сборка образов), а OpenVPN не сможет форвардить трафик клиентов
        # вообще. docker0 — дефолтная bridge-сеть, br-* — именованные сети
        # docker-compose (у нас ovpn-stack-vpn).
        iifname "docker0" accept
        oifname "docker0" accept
        iifname "br-*" accept
        oifname "br-*" accept
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
