name: ovpn-stack-vpn

# Рендерится install-vpn.sh (render-compose) в install-render/docker-compose.yml.
# Блоки # BEGIN.../# END... вырезаются целиком, если режим их не требует —
# не редактировать руками, правки потеряются при следующем прогоне.

x-logging: &default-logging
  driver: "json-file"
  options:
    max-size: "10m"
    max-file: "3"

services:
# BEGIN VLESS
  3x-ui:
    # запинено на v3.4.2, НЕ :latest — :latest тянет xray-core 26.7.11+,
    # где REALITY-инбаунды стали отклонять всех клиентов новым дефолтом
    # minClientVer (MHSanaei/3x-ui issue #5922, закрыт как "не будем
    # чинить"). v3.4.2 подтверждённо тянет xray-core v26.6.27 (DockerInit.sh
    # пинит его явно) — последняя версия до регрессии. Проверено вживую:
    # с :latest REALITY-хэндшейк падал и на xray-core, и на sing-box-клиенте
    # с одинаковыми ключами/параметрами; с v3.4.2 отпадает необходимость
    # разбираться с minClientVer вручную.
    image: ghcr.io/mhsanaei/3x-ui:v3.4.2
    container_name: 3x-ui
    restart: unless-stopped
    logging: *default-logging
    # host-сеть обязательна: в bridge Docker подменяет source-адрес клиентов
    # (сломает статистику) и панель подставляет в ссылки адрес контейнера.
    network_mode: host
    environment:
      XRAY_VMESS_AEAD_FORCED: "false"
    volumes:
      - @@REPO_ROOT@@/data/xui:/etc/x-ui
    # никакой секции ports — network_mode: host игнорирует её.
    # веб-панель обязана слушать 127.0.0.1 (см. xui-configure) — в host-сети
    # её больше не защищает docker-сеть.
# END VLESS
# BEGIN OPENVPN
  openvpn:
    build:
      context: @@REPO_ROOT@@/admin
      dockerfile: Dockerfile.openvpn
    image: ovpn-stack/openvpn:local
    container_name: ovpn-stack-openvpn
    restart: unless-stopped
    logging: *default-logging
    command: /etc/openvpn/setup/configure.sh
    environment:
      OVPN_SERVER_NET: "10.1.0.0"
      OVPN_SERVER_MASK: "255.255.255.0"
    cap_add:
      - NET_ADMIN
    sysctls:
      - net.ipv4.ip_forward=1
    ports:
      - "@@OVPN_UDP_PORT@@:1194/udp"
    volumes:
      - @@REPO_ROOT@@/data/easyrsa:/etc/openvpn/easyrsa
      - @@REPO_ROOT@@/data/ccd:/etc/openvpn/ccd
    networks:
      - ovpn-stack-vpn
    healthcheck:
      test: ["CMD-SHELL", "pidof openvpn >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  ovpn-admin:
    build:
      context: @@REPO_ROOT@@/admin
      dockerfile: Dockerfile.ovpn-admin
      network: host
    image: ovpn-stack/ovpn-admin:local
    container_name: ovpn-stack-ovpn-admin
    restart: unless-stopped
    logging: *default-logging
    command: /app/ovpn-admin
    depends_on:
      openvpn:
        condition: service_healthy
    environment:
      OVPN_NETWORK: "10.1.0.0/24"
      OVPN_CCD: "true"
      OVPN_CCD_PATH: "/mnt/ccd"
      EASYRSA_PATH: "/mnt/easyrsa"
      OVPN_SERVER: "@@PUBLIC_IP@@:@@OVPN_UDP_PORT@@:udp"
      # плашка «СЕРВЕР» в панели: без этого serverName() падает на
      # os.Hostname() = id контейнера (ovpn-admin в своём UTS-namespace)
      OVPN_SERVER_NAME: "@@PUBLIC_IP@@"
      OVPN_INDEX_PATH: "/mnt/easyrsa/pki/index.txt"
      OVPN_STAT_DB: "/mnt/stat/traffic.db"
      LOG_LEVEL: "info"
    # тот же сетевой namespace, что и openvpn — доступ к mgmt 127.0.0.1:8989,
    # сам наружу не публикуется, за ним идёт nginx на 8443.
    network_mode: "service:openvpn"
    volumes:
      - @@REPO_ROOT@@/data/easyrsa:/mnt/easyrsa
      - @@REPO_ROOT@@/data/ccd:/mnt/ccd
      - @@REPO_ROOT@@/data/stat:/mnt/stat
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 40s
# END OPENVPN

  nginx:
    image: nginx:alpine
    container_name: ovpn-stack-nginx
    restart: unless-stopped
    logging: *default-logging
    # 3x-ui (network_mode: host) слушает панель на 0.0.0.0 хоста — из
    # bridge-сети контейнера её не достать через 127.0.0.1, только через
    # host-gateway; доступ снаружи всё равно закрыт nftables (см. install/README.md).
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "80:80"
      - "8443:8443"
    volumes:
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./nginx/ssl:/etc/nginx/ssl:ro
      - ./nginx/acme:/var/www/acme:ro
      - ./nginx/html:/usr/share/nginx/html:ro
      - ./nginx/htpasswd:/etc/nginx/htpasswd:ro
    networks:
      - ovpn-stack-vpn
    healthcheck:
      # порт 80 всегда 301-редиректит на :8443 (см. nginx.conf.tmpl) — обычный
      # wget идёт за редиректом и там валит TLS-цепочку, потому что сертификат
      # выписан на публичный IP, а не на 127.0.0.1, которым мы стучимся отсюда.
      test: ["CMD-SHELL", "wget -q -O /dev/null --no-check-certificate http://127.0.0.1:80/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  ovpn-stack-vpn:
    driver: bridge
