# Рендерится install-vpn.sh (render-nginx) в install-render/nginx/conf.d/default.conf.
# Блоки # BEGIN.../# END... вырезаются целиком, если режим их не требует.
# Панели — по неочевидным путям, limit_req вместо fail2ban (см. README §8, §11).

limit_req_zone $binary_remote_addr zone=panels:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host:8443$request_uri;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name _;
    http2 on;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }

# BEGIN VLESS
    location @@XUI_BASE_PATH@@ {
        limit_req zone=panels burst=20 nodelay;
        proxy_pass http://host.docker.internal:@@XUI_PORT@@@@XUI_BASE_PATH@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # 3x-ui sub-сервер (порт 2096) — подписки и JSON-подписки по неочевидным
    # путям. Домена нет, поэтому и панель, и подписка живут на :8443; QR из
    # панели 3x-ui за прокси на нестандартном порту склеивает URL без пути и
    # непригоден — рабочий URL подписки выводится в сводку установки.
    location @@SUB_PATH@@ {
        limit_req zone=panels burst=20 nodelay;
        proxy_pass http://host.docker.internal:2096@@SUB_PATH@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location @@SUB_JSON_PATH@@ {
        limit_req zone=panels burst=20 nodelay;
        proxy_pass http://host.docker.internal:2096@@SUB_JSON_PATH@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
# END VLESS
# BEGIN OPENVPN
    location @@OVPN_ADMIN_PATH@@ {
        limit_req zone=panels burst=20 nodelay;
        # у ovpn-admin нет своего логина (в отличие от 3x-ui) — без Basic
        # Auth секретный путь был бы единственной защитой, то есть вообще
        # без пароля. htpasswd генерируется install-vpn.sh htpasswd-generate.
        auth_basic           "ovpn-admin";
        auth_basic_user_file /etc/nginx/htpasswd;
        # ovpn-admin делит netns с openvpn (network_mode: service:openvpn),
        # своего DNS-имени в compose-сети у него нет — апстрим через openvpn.
        # В отличие от 3x-ui, у ovpn-admin нет своего webBasePath — приложение
        # ничего не знает о префиксе пути, поэтому proxy_pass без него: nginx
        # срезает location-префикс перед проксированием.
        proxy_pass http://openvpn:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
# END OPENVPN
}
