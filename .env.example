# ─────────────────────────────────────────────────────────────────────────────
# Скопируйте в .env и заполните своими значениями:  cp .env.example .env
# Файл .env в .gitignore — секреты в репозиторий не попадают.
# ─────────────────────────────────────────────────────────────────────────────

# Публичный IP (или домен) VPS.
# Используется: OpenVPN-сервером (адрес в клиентских .ovpn), Grafana (root_url).
VPS_PUBLIC_IP=203.0.113.10

# Basic Auth для nginx — закрывает панель ovpn-admin и Grafana снаружи.
# .htpasswd генерируется из этих значений автоматически при старте nginx.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-strong-password

# Пароль администратора Grafana (логин: admin).
GRAFANA_ADMIN_PASSWORD=change-me-another-strong-password

# Необязательно: имя сервера в плитке «Сервер» панели.
# Если пусто — берётся имя хоста (/etc/hostname).
#OVPN_SERVER_NAME=
