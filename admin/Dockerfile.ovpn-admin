FROM node:26-alpine AS frontend-builder
COPY frontend /app
RUN cd /app && npm ci && npm run build

FROM golang:1.27-alpine AS backend-builder
COPY . /app
COPY --from=frontend-builder /app/static /app/frontend/static
# BuildKit подставляет реальную арку из --platform; =amd64 — фолбэк для legacy-билдера
ARG TARGETARCH=amd64
# CGO не нужен: bbolt — чистый Go, PKI-операции идут через easyrsa/openssl (shell)
RUN cd /app && env CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -buildvcs=false -ldflags '-s -w' -o ovpn-admin

FROM alpine:3.24
WORKDIR /app
COPY --from=backend-builder /app/ovpn-admin /app
RUN apk add --update bash easy-rsa openssl && \
    ln -s /usr/share/easy-rsa/easyrsa /usr/local/bin && \
    rm -rf /tmp/* /var/tmp/* /var/cache/apk/* /var/cache/distfiles/*
