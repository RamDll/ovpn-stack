# Секреты и локальная конфигурация
.env
nginx/.htpasswd
.claude/settings.local.json

# TLS-сертификаты и ACME-challenge
nginx/ssl/*
!nginx/ssl/.gitkeep
nginx/acme/*
!nginx/acme/.gitkeep

# Логи nginx для fail2ban (пишутся в рантайме)
nginx/f2b-log/*
!nginx/f2b-log/.gitkeep

# Рантайм-данные OpenVPN: PKI (приватные ключи!), CCD, база пользователей
data/

# Вывод установщика из install/ при запуске из git-чекаута (напр. /opt/ovpn-stack):
# отрендеренные конфиги с секретами (privkey.pem, htpasswd) и state по серверам.
# Секреты не в git — см. install/README.md, принцип 7.
install-render/
/state/

# Build-артефакты
*.log
admin/ovpn-admin
admin/frontend/node_modules
admin/frontend/static
