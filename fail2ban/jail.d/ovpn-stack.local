# fail2ban для ovpn-stack. Скопировать на хост в /etc/fail2ban/jail.d/, затем:
#   fail2ban-client reload
#
# ВАЖНО: logpath ниже указан для развёртывания в /root/ovpn-stack.
# Поправьте под свой каталог, если он другой.
#
# Отказы Basic Auth (панель + Grafana) ловятся штатным фильтром nginx-http-auth
# по error.log 443-го server-блока (nginx пишет его в ./nginx/f2b-log/).
# OpenVPN здесь только по сертификату — брутить нечего, джейла для него нет.
#
# banaction = iptables в цепочке DOCKER-USER: трафик к опубликованным портам
# контейнера идёт через FORWARD/DOCKER-USER, а НЕ через INPUT, поэтому обычный
# ufw/iptables-INPUT бан его не остановит. Заодно это не трогает SSH на хосте —
# ошибиться паролём в панели и потерять доступ по ssh нельзя.

[nginx-http-auth]
enabled   = true
port      = http,https
logpath   = /root/ovpn-stack/nginx/f2b-log/error.log
banaction = iptables-allports[chain="DOCKER-USER"]
maxretry  = 5
findtime  = 10m
bantime   = 1h
